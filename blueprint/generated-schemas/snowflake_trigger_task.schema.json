{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Snowflake Trigger Task",
  "type": "object",
  "properties": {
    "task_name": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "snowflake_conn_id": {
      "type": "string",
      "default": "snowflake_conn"
    },
    "warehouse": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "poke_interval": {
      "type": "integer",
      "minimum": 5,
      "default": 30
    },
    "process_timeout": {
      "type": "integer",
      "minimum": 60,
      "default": 3600
    },
    "blueprint": {
      "type": "string",
      "const": "snowflake_trigger_task"
    },
    "version": {
      "type": "integer",
      "const": 1
    }
  },
  "required": [
    "task_name",
    "database",
    "schema",
    "blueprint",
    "version"
  ]
}